<?xml version="1.0" encoding="utf-8"?>
<!-- Metro wide screens, right pane of the main screen: what is playing now.
     Tapping it opens the player. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/metro_now_pane_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="@string/metro_tile_now_playing"
        android:textColor="?attr/colorOnSurface"
        android:textSize="22sp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="8dp"
            android:alpha="0.85"
            android:importantForAccessibility="no"
            android:scaleType="fitEnd"
            android:src="@drawable/metro_bars_left"
            app:layout_constraintBottom_toBottomOf="@id/metro_now_art"
            app:layout_constraintEnd_toStartOf="@id/metro_now_art"
            app:layout_constraintHeight_percent="0.45"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/metro_now_art"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="?attr/metroPanel"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="360dp"
            app:layout_constraintWidth_percent="0.62" />

        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:alpha="0.85"
            android:importantForAccessibility="no"
            android:scaleType="fitEnd"
            android:scaleX="-1"
            android:src="@drawable/metro_bars_left"
            app:layout_constraintBottom_toBottomOf="@id/metro_now_art"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.45"
            app:layout_constraintStart_toEndOf="@id/metro_now_art" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/metro_now_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="?attr/colorOnSurface"
        android:textSize="22sp" />

    <ImageButton
        android:id="@+id/metro_now_open"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/metro_play_circle"
        android:contentDescription="@string/metro_tile_now_playing"
        android:padding="18dp"
        android:scaleType="fitCenter"
        android:src="@drawable/metro_play" />
</LinearLayout>
