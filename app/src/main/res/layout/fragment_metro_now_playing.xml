<?xml version="1.0" encoding="utf-8"?>
<!-- Metro panorama "now playing" (Windows Phone Xbox Music): song and station
     above a left-aligned picture, shuffle / repeat / queue beside it, a thin
     progress line (or LIVE for radio) and round outline buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/metro_np_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="?attr/colorOnSurface"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/metro_np_by"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/metro_np_art"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="?attr/metroPanel"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"
                app:layout_constraintWidth_max="480dp" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/metro_np_shuffle"
                style="@style/Widget.ServeStream.Metro.PlayerButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_m3_shuffle" />

            <ImageButton
                android:id="@+id/metro_np_repeat"
                style="@style/Widget.ServeStream.Metro.PlayerButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_m3_repeat" />

            <ImageButton
                android:id="@+id/metro_np_queue"
                style="@style/Widget.ServeStream.Metro.PlayerButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/now_playing_label"
                android:src="@drawable/ic_m3_queue_music" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/metro_np_time_row"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/metro_np_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="@string/metro_live"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/metro_np_elapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="40dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/metro_np_seek"
            style="@style/Widget.ServeStream.Metro.SeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="1000" />

        <TextView
            android:id="@+id/metro_np_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:minWidth="44dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/metro_np_queue_pos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/metro_np_prev"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/metro_circle_outline"
            android:contentDescription="@string/previous_action_title"
            android:padding="15dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_m3_skip_previous"
            app:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/metro_np_play"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/metro_circle_outline"
            android:contentDescription="@string/play"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:src="@drawable/metro_play_line" />

        <ImageButton
            android:id="@+id/metro_np_next"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/metro_circle_outline"
            android:contentDescription="@string/next_action_title"
            android:padding="15dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_m3_skip_next"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>
</LinearLayout>
