<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded grey push button -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="14dp" />
            <gradient android:angle="270" android:startColor="#A8A49C" android:endColor="#E2DFD8" />
            <stroke android:width="1dp" android:color="#444444" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="14dp" />
            <gradient android:angle="270" android:startColor="#FFFFFF" android:centerColor="#E6E3DC" android:endColor="#B4B0A8" />
            <stroke android:width="1dp" android:color="#5A5A5A" />
        </shape>
    </item>
</selector>
