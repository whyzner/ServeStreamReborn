<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- recessed well -->
    <item><shape android:shape="oval"><gradient android:angle="270" android:startColor="#7A7A7A" android:endColor="#F2F2F2" /></shape></item>
    <!-- metal knob -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#F7F7F7" android:centerColor="#C9C9C9" android:endColor="#9C9C9C" />
            <stroke android:width="1dp" android:color="#6A6A6A" />
        </shape>
    </item>
</layer-list>
