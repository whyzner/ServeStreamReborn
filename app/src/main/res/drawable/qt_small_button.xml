<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="5dp" />
            <gradient android:angle="270" android:startColor="#555555" android:endColor="#7A7A7A" />
            <stroke android:width="1dp" android:color="#262626" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="5dp" />
            <gradient android:angle="270" android:startColor="#A9A9A9" android:endColor="#6C6C6C" />
            <stroke android:width="1dp" android:color="#2E2E2E" />
        </shape>
    </item>
</selector>
