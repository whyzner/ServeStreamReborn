<?xml version="1.0" encoding="utf-8"?>
<!-- Dark grey control drawer under the metal body -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape><corners android:radius="12dp" /><solid android:color="#2E2E2E" /></shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <corners android:radius="11dp" />
            <gradient android:angle="270" android:startColor="#737373" android:endColor="#4B4B4B" />
        </shape>
    </item>
</layer-list>
