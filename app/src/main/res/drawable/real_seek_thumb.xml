<?xml version="1.0" encoding="utf-8"?>
<!-- Small rounded grey slider knob -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="22dp" android:height="14dp">
        <shape>
            <corners android:radius="7dp" />
            <gradient android:angle="270" android:startColor="#FFFFFF" android:endColor="#A8A49C" />
            <stroke android:width="1dp" android:color="#3A3A3A" />
        </shape>
    </item>
</layer-list>
