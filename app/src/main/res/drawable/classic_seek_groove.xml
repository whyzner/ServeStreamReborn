<?xml version="1.0" encoding="utf-8"?>
<!-- Seek bar: thin sunken groove, no coloured fill -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical" android:height="5dp">
        <layer-list>
            <item><shape><solid android:color="@color/classic_shadow" /></shape></item>
            <item android:top="1dp" android:left="1dp"><shape><solid android:color="@color/classic_white" /></shape></item>
            <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp"><shape><solid android:color="@color/classic_black" /></shape></item>
            <item android:top="2dp" android:left="2dp" android:right="1dp" android:bottom="1dp"><shape><solid android:color="@color/classic_face" /></shape></item>
        </layer-list>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><solid android:color="@android:color/transparent" /></shape></clip>
    </item>
</layer-list>
