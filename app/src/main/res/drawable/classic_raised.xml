<?xml version="1.0" encoding="utf-8"?>
<!-- Raised 3D edge: white/light top-left, grey/black bottom-right -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="@color/classic_black" /></shape></item>
    <item android:right="1dp" android:bottom="1dp"><shape><solid android:color="@color/classic_white" /></shape></item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp"><shape><solid android:color="@color/classic_shadow" /></shape></item>
    <item android:left="1dp" android:top="1dp" android:right="2dp" android:bottom="2dp"><shape><solid android:color="@color/classic_light" /></shape></item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp"><shape><solid android:color="@color/classic_face" /></shape></item>
</layer-list>
