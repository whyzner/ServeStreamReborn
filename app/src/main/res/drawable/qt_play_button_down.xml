<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="oval"><gradient android:angle="270" android:startColor="#7A7A7A" android:endColor="#F2F2F2" /></shape></item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#8E8E8E" android:centerColor="#ABABAB" android:endColor="#C8C8C8" />
            <stroke android:width="1dp" android:color="#555555" />
        </shape>
    </item>
</layer-list>
