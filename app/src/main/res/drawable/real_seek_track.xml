<?xml version="1.0" encoding="utf-8"?>
<!-- Seek bar: dark sunken groove with a dotted scale feel, no coloured fill -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical" android:height="6dp">
        <layer-list>
            <item><shape><corners android:radius="3dp" /><solid android:color="@color/real_shadow" /></shape></item>
            <item android:top="1dp" android:left="1dp"><shape><corners android:radius="3dp" /><solid android:color="@color/real_light" /></shape></item>
            <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp"><shape><corners android:radius="2dp" /><solid android:color="#3A3A3A" /></shape></item>
        </layer-list>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><solid android:color="@android:color/transparent" /></shape></clip>
    </item>
</layer-list>
