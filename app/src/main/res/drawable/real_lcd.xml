<?xml version="1.0" encoding="utf-8"?>
<!-- Black status display in a sunken frame -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><corners android:radius="3dp" /><solid android:color="@color/real_shadow" /></shape></item>
    <item android:left="1dp" android:top="1dp"><shape><corners android:radius="3dp" /><solid android:color="@color/real_light" /></shape></item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp"><shape><corners android:radius="2dp" /><solid android:color="#101010" /></shape></item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp"><shape><corners android:radius="2dp" /><solid android:color="#000000" /></shape></item>
</layer-list>
