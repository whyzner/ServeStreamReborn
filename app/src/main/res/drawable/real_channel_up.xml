<?xml version="1.0" encoding="utf-8"?>
<!-- Blue 3D "channel" button -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="#000033" /></shape></item>
    <item android:right="1dp" android:bottom="1dp"><shape><solid android:color="#A9C4F0" /></shape></item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp"><shape><solid android:color="#1E3C7A" /></shape></item>
    <item android:left="1dp" android:top="1dp" android:right="2dp" android:bottom="2dp">
        <shape><gradient android:angle="270" android:startColor="#6F96DA" android:endColor="#2B529F" /></shape>
    </item>
</layer-list>
