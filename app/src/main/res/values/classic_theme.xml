<?xml version="1.0" encoding="utf-8"?>
<!-- "Classic" theme: late-90s desktop look (grey 3D chrome, gradient title bars,
     square corners). Applied on top of the normal theme as an overlay. -->
<resources>
    <color name="classic_face">#C0C0C0</color>
    <color name="classic_light">#DFDFDF</color>
    <color name="classic_shadow">#808080</color>
    <color name="classic_white">#FFFFFF</color>
    <color name="classic_black">#000000</color>
    <color name="classic_title">#000080</color>
    <color name="classic_title_end">#1084D0</color>

    <style name="ShapeAppearance.ServeStream.Square" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>

    <style name="ThemeOverlay.ServeStream.Classic" parent="">
        <!-- colours -->
        <item name="colorPrimary">@color/classic_title</item>
        <item name="colorOnPrimary">@color/classic_white</item>
        <item name="colorPrimaryContainer">@color/classic_title</item>
        <item name="colorOnPrimaryContainer">@color/classic_white</item>
        <item name="colorSecondary">@color/classic_title</item>
        <item name="colorOnSecondary">@color/classic_white</item>
        <item name="colorSecondaryContainer">@color/classic_face</item>
        <item name="colorOnSecondaryContainer">@color/classic_black</item>
        <item name="colorTertiary">@color/classic_title</item>
        <item name="colorSurface">@color/classic_face</item>
        <item name="colorOnSurface">@color/classic_black</item>
        <item name="colorSurfaceVariant">@color/classic_face</item>
        <item name="colorOnSurfaceVariant">#202020</item>
        <item name="colorSurfaceContainerLowest">@color/classic_white</item>
        <item name="colorSurfaceContainerLow">@color/classic_face</item>
        <item name="colorSurfaceContainer">@color/classic_face</item>
        <item name="colorSurfaceContainerHigh">@color/classic_face</item>
        <item name="colorSurfaceContainerHighest">@color/classic_face</item>
        <item name="colorSurfaceBright">@color/classic_face</item>
        <item name="colorSurfaceDim">@color/classic_face</item>
        <item name="colorOutline">@color/classic_shadow</item>
        <item name="colorOutlineVariant">@color/classic_shadow</item>
        <item name="android:colorBackground">@color/classic_face</item>
        <item name="android:windowBackground">@color/classic_face</item>
        <item name="android:textColorPrimary">@color/classic_black</item>
        <item name="android:textColorSecondary">#202020</item>
        <item name="colorControlActivated">@color/classic_title</item>
        <item name="elevationOverlayEnabled">false</item>

        <!-- square corners everywhere -->
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="stationImageShape">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="playerArtCorner">0dp</item>

        <!-- title bars -->
        <item name="toolbarStyle">@style/Widget.ServeStream.Classic.Toolbar</item>
        <item name="actionBarStyle">@style/Widget.ServeStream.Classic.ActionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.ServeStream.Classic.TitleBar</item>

        <!-- 3D controls -->
        <item name="materialButtonStyle">@style/Widget.ServeStream.Classic.Button</item>
        <item name="borderlessButtonStyle">@style/Widget.ServeStream.Classic.Button</item>
        <item name="floatingActionButtonStyle">@style/Widget.ServeStream.Classic.Fab</item>
        <item name="navigationViewStyle">@style/Widget.ServeStream.Classic.NavigationView</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ServeStream.Classic.Dialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.ServeStream.Classic.Dialog</item>
        <item name="android:listDivider">@drawable/classic_divider</item>
        <item name="divider_horizontal">@drawable/classic_divider</item>
        <item name="nav_drawer_background">@color/classic_face</item>
        <item name="now_playing_item_color">@color/classic_title</item>
    </style>

    <style name="ThemeOverlay.ServeStream.Classic.TitleBar" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="colorOnSurface">@color/classic_white</item>
        <item name="colorOnSurfaceVariant">@color/classic_white</item>
        <item name="colorControlNormal">@color/classic_white</item>
        <item name="android:textColorPrimary">@color/classic_white</item>
    </style>

    <style name="TextAppearance.ServeStream.Classic.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/classic_white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.ServeStream.Classic.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@drawable/classic_titlebar</item>
        <item name="titleTextColor">@color/classic_white</item>
        <item name="subtitleTextColor">@color/classic_white</item>
        <item name="navigationIconTint">@color/classic_white</item>
        <item name="titleTextAppearance">@style/TextAppearance.ServeStream.Classic.Title</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.ServeStream.Classic.TitleBar</item>
    </style>

    <style name="Widget.ServeStream.Classic.ActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@drawable/classic_titlebar</item>
        <item name="elevation">0dp</item>
        <item name="titleTextStyle">@style/TextAppearance.ServeStream.Classic.Title</item>
    </style>

    <style name="Widget.ServeStream.Classic.Button" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/classic_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/classic_black</item>
        <item name="iconTint">@color/classic_black</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="cornerRadius">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.ServeStream.Classic.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="backgroundTint">@color/classic_face</item>
        <item name="tint">@color/classic_black</item>
        <item name="rippleColor">@color/classic_shadow</item>
        <item name="elevation">3dp</item>
    </style>

    <style name="Widget.ServeStream.Classic.NavigationView" parent="Widget.Material3.NavigationView">
        <item name="android:background">@color/classic_face</item>
        <item name="drawerLayoutCornerSize">0dp</item>
        <item name="itemShapeAppearanceOverlay">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="itemShapeFillColor">@color/classic_nav_fill</item>
        <item name="itemTextColor">@color/classic_nav_text</item>
        <item name="itemIconTint">@color/classic_nav_text</item>
    </style>

    <style name="ThemeOverlay.ServeStream.Classic.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/classic_face</item>
        <item name="colorSurfaceContainerHigh">@color/classic_face</item>
        <item name="colorOnSurface">@color/classic_black</item>
        <item name="colorOnSurfaceVariant">@color/classic_black</item>
        <item name="colorPrimary">@color/classic_title</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.ServeStream.Classic.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.ServeStream.Classic.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.ServeStream.Classic.DialogButton</item>
    </style>

    <style name="Widget.ServeStream.Classic.DialogButton" parent="Widget.ServeStream.Classic.Button">
        <item name="android:minWidth">88dp</item>
        <item name="android:layout_marginStart">8dp</item>
    </style>
</resources>
