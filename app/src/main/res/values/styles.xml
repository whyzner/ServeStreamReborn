<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Material 3 base theme: follows the system light/dark mode and,
         on Android 12+, the wallpaper colours (dynamic colour). -->
    <style name="Base.Theme.ServeStream" parent="Theme.Material3.DayNight">
        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="actionBarStyle">@style/Widget.ServeStream.ActionBar</item>
        <item name="toolbarStyle">@style/Widget.Material3.Toolbar.Surface</item>
        <item name="actionOverflowButtonStyle">@style/Widget.ServeStream.ActionButton.Overflow</item>
        <item name="android:listDivider">@drawable/m3_divider</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.Material3.Dialog.Alert</item>
        <item name="android:alertDialogTheme">@style/ServeStream.FrameworkDialog</item>
        <item name="floatingActionButtonStyle">@style/Widget.Material3.FloatingActionButton.Primary</item>

        <!-- icons (Material Symbols, tinted by the theme) -->
        <item name="ic_action_search">@drawable/ic_m3_search</item>
        <item name="ic_action_new">@drawable/ic_m3_add</item>
        <item name="drawer_shadow">@android:color/transparent</item>
        <item name="ic_drawer">@drawable/ic_m3_menu</item>
        <item name="ic_action_volume_on">@drawable/ic_m3_volume_up</item>
        <item name="ic_action_accept">@drawable/ic_m3_check</item>
        <item name="ic_action_refresh">@drawable/ic_m3_refresh</item>
        <item name="borderless_button">@drawable/borderless_ripple</item>
        <item name="ic_action_overflow">@drawable/ic_m3_more_vert</item>
        <item name="ic_action_settings">@drawable/ic_m3_settings</item>
        <item name="ic_action_settings_drawer">@drawable/ic_m3_settings</item>
        <item name="ic_action_discard">@drawable/ic_m3_delete</item>
        <item name="ic_action_cancel">@drawable/ic_m3_close</item>
        <item name="float_background_color">@android:color/transparent</item>

        <item name="ic_av_repeat">@drawable/ic_m3_repeat</item>
        <item name="ic_av_previous">@drawable/ic_m3_skip_previous</item>
        <item name="ic_av_pause_over_video_large">@drawable/ic_m3_pause_circle</item>
        <item name="ic_av_play_over_video_large">@drawable/ic_m3_play_circle</item>
        <item name="ic_av_next">@drawable/ic_m3_skip_next</item>
        <item name="ic_av_shuffle">@drawable/ic_m3_shuffle</item>
        <item name="ic_av_play">@drawable/ic_m3_play</item>
        <item name="ic_av_pause">@drawable/ic_m3_pause</item>

        <item name="media_player_metadata_color_primary">?attr/colorOnSurfaceVariant</item>
        <item name="media_player_metadata_color_secondary">?attr/colorOnSurface</item>
        <item name="now_playing_item_color">?attr/colorPrimary</item>

        <item name="ic_mini_controller_pause">@drawable/ic_m3_pause</item>
        <item name="ic_mini_controller_play">@drawable/ic_m3_play</item>
        <item name="ic_mini_controller_stop">@drawable/ic_m3_stop</item>

        <item name="divider_horizontal">@drawable/m3_divider</item>
        <item name="nav_drawer_background">?attr/colorSurfaceContainerLow</item>
        <item name="stationImageShape">@style/ShapeAppearance.ServeStream.StationImage</item>
        <item name="playerArtCorner">28dp</item>
        <item name="appLogo">@drawable/app_logo</item>

        <!-- player screen: these defaults keep the normal look -->
        <item name="playerBackground">@null</item>
        <item name="playerTimeStripBackground">@null</item>
        <item name="playerTimeStripPadding">0dp</item>
        <item name="playerTimeTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="playerTimeTextAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="playerSeekBarStyle">?android:attr/seekBarStyle</item>
        <item name="playerButtonRowBackground">@null</item>
        <item name="playerButtonRowPadding">0dp</item>
        <item name="playerSmallButtonStyle">@style/Widget.ServeStream.IconButton</item>
        <item name="playerPlayButtonBackground">?attr/selectableItemBackgroundBorderless</item>
        <item name="playerPlayButtonPadding">0dp</item>
        <item name="playerArtCardStyle">@style/Widget.Material3.CardView.Filled</item>
        <item name="playerArtAreaBackground">@null</item>
        <item name="playerInfoBackground">@null</item>
        <item name="playerInfoVisibility">0</item>
        <item name="playerFieldsVisibility">2</item>
        <item name="playerTimeRowVisibility">0</item>
        <item name="playerLcdVisibility">2</item>
    </style>

    <!-- Names kept from the original app so the manifest and code still resolve. -->
    <style name="Theme.ServeStream.DarkActionBar" parent="Base.Theme.ServeStream" />
    <style name="Theme.ServeStream.Dark" parent="Base.Theme.ServeStream" />
    <style name="AppTheme" parent="Base.Theme.ServeStream" />

    <style name="Theme.ServeStream.DarkActionBar.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.ServeStream.Alarm" parent="Theme.ServeStream.DarkActionBar.NoActionBar" />

    <style name="Theme.ServeStream.DarkActionBar.AppBarOverlay" parent="ThemeOverlay.Material3" />
    <style name="Theme.ServeStream.DarkActionBar.PopupOverlay" parent="ThemeOverlay.Material3" />

    <style name="Widget.ServeStream.ActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">?attr/colorSurface</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.ServeStream.ActionButton.Overflow" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="srcCompat">@drawable/ic_m3_more_vert</item>
        <item name="android:src">@drawable/ic_m3_more_vert</item>
    </style>

    <!-- List rows -->
    <style name="TextAppearance.ServeStream.ListTitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.ServeStream.ListSubtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.ServeStream.IconButton" parent="">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <!-- Framework dialogs (e.g. settings lists) can't use Material3 overlays -->
    <style name="ServeStream.FrameworkDialog" parent="@android:style/Theme.DeviceDefault.Light.Dialog.Alert" />
    <style name="ShapeAppearance.ServeStream.StationImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
</resources>
