<?xml version="1.0" encoding="utf-8"?>
<!-- "Metro" themes (Metro Dark / Metro Light): Windows Phone 8 style - flat,
     square, typography first, one blue accent and coloured tiles.
     Dark = very dark charcoal background, light = near white background.
     Both share layouts and tile colours; only background / text / icon
     brightness change. Applied on top of the normal theme as an overlay. -->
<resources>
    <color name="metro_accent">#0078D7</color>
    <!-- tile colours (same in dark and light) -->
    <color name="metro_tile_stations">#0078D7</color>
    <color name="metro_tile_browse">#8A2BE2</color>
    <color name="metro_tile_alarm">#00A693</color>
    <color name="metro_tile_now_playing">#E53935</color>
    <!-- dark -->
    <color name="metro_dark_bg">#0D1117</color>
    <color name="metro_dark_panel">#1F1F1F</color>
    <color name="metro_dark_panel_high">#2A2A2A</color>
    <color name="metro_dark_text2">#A6A6A6</color>
    <color name="metro_dark_line">#2E2E2E</color>
    <color name="metro_dark_selected">#1B4F96</color>
    <!-- light -->
    <color name="metro_light_bg">#FAFAFA</color>
    <color name="metro_light_panel">#EEF3FA</color>
    <color name="metro_light_panel_high">#E2EAF5</color>
    <color name="metro_light_text2">#666666</color>
    <color name="metro_light_line">#DDDDDD</color>
    <color name="metro_light_selected">#DCEAFB</color>

    <style name="TextAppearance.ServeStream.Metro.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- shared by both: shapes, widgets -->
    <style name="ThemeOverlay.ServeStream.MetroBase" parent="">
        <item name="settingsDropdownBackground">@drawable/metro_dropdown_box</item>
        <item name="colorPrimary">@color/metro_accent</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/metro_accent</item>
        <item name="colorOnPrimaryContainer">@android:color/white</item>
        <item name="colorSecondary">@color/metro_accent</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="colorSecondaryContainer">@color/metro_accent</item>
        <item name="colorOnSecondaryContainer">@android:color/white</item>
        <item name="colorTertiary">@color/metro_accent</item>
        <item name="colorControlActivated">@color/metro_accent</item>
        <item name="elevationOverlayEnabled">false</item>

        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="stationImageShape">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="playerArtCorner">0dp</item>
        <item name="appLogo">@drawable/app_logo_metro</item>

        <item name="toolbarStyle">@style/Widget.ServeStream.Metro.Toolbar</item>
        <item name="actionBarStyle">@style/Widget.ServeStream.Metro.ActionBar</item>
        <item name="materialButtonStyle">@style/Widget.ServeStream.Metro.Button</item>
        <item name="borderlessButtonStyle">@style/Widget.ServeStream.Metro.Button</item>
        <item name="floatingActionButtonStyle">@style/Widget.ServeStream.Metro.Fab</item>
        <item name="navigationViewStyle">@style/Widget.ServeStream.Metro.NavigationView</item>
        <item name="android:listDivider">@drawable/metro_divider</item>
        <item name="divider_horizontal">@drawable/metro_divider</item>
        <item name="now_playing_item_color">@color/metro_accent</item>

        <!-- player: Windows Phone music app look - round outline buttons, thin accent progress line -->
        <item name="playerArtCorner">0dp</item>
        <item name="playerTimeTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="playerSeekBarStyle">@style/Widget.ServeStream.Metro.SeekBar</item>
        <item name="playerSmallButtonStyle">@style/Widget.ServeStream.Metro.PlayerButton</item>
        <item name="playerPlayButtonBackground">@drawable/metro_circle_outline</item>
        <item name="playerPlayButtonPadding">15dp</item>
        <item name="ic_av_play_over_video_large">@drawable/metro_play_line</item>
        <item name="ic_av_pause_over_video_large">@drawable/metro_pause_line</item>
        <item name="playerInfoVisibility">0</item>
        <item name="playerFieldsVisibility">2</item>
        <item name="playerTimeRowVisibility">0</item>
        <item name="playerLcdVisibility">2</item>
    </style>

    <style name="Widget.ServeStream.Metro.SeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressTint">@color/metro_accent</item>
        <item name="android:thumbTint">@color/metro_accent</item>
        <item name="android:progressBackgroundTint">?attr/colorOutline</item>
        <item name="android:splitTrack">false</item>
    </style>

    <style name="Widget.ServeStream.Metro.PlayerButton" parent="Widget.ServeStream.IconButton">
        <item name="android:tint">?attr/colorOnSurface</item>
    </style>

    <style name="ThemeOverlay.ServeStream.MetroDark" parent="ThemeOverlay.ServeStream.MetroBase">
        <item name="colorSurface">@color/metro_dark_bg</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorSurfaceVariant">@color/metro_dark_panel</item>
        <item name="colorOnSurfaceVariant">@color/metro_dark_text2</item>
        <item name="colorOnBackground">#FFFFFF</item>
        <item name="colorSurfaceContainerLowest">@color/metro_dark_bg</item>
        <item name="colorSurfaceContainerLow">@color/metro_dark_bg</item>
        <item name="colorSurfaceContainer">@color/metro_dark_panel</item>
        <item name="colorSurfaceContainerHigh">@color/metro_dark_panel</item>
        <item name="colorSurfaceContainerHighest">@color/metro_dark_panel_high</item>
        <item name="colorSurfaceBright">@color/metro_dark_panel</item>
        <item name="colorSurfaceDim">@color/metro_dark_bg</item>
        <item name="colorOutline">#5A5A5A</item>
        <item name="colorOutlineVariant">@color/metro_dark_line</item>
        <item name="android:colorBackground">@color/metro_dark_bg</item>
        <item name="android:windowBackground">@color/metro_dark_bg</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">@color/metro_dark_text2</item>
        <item name="nav_drawer_background">@color/metro_dark_bg</item>
        <item name="metroPanel">@color/metro_dark_panel</item>
        <item name="metroSelectedRow">@color/metro_dark_selected</item>
        <item name="playerBackground">@color/metro_dark_bg</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ServeStream.MetroDark.Dialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.ServeStream.MetroDark.Dialog</item>
    </style>

    <style name="ThemeOverlay.ServeStream.MetroLight" parent="ThemeOverlay.ServeStream.MetroBase">
        <item name="colorSurface">@color/metro_light_bg</item>
        <item name="colorOnSurface">#000000</item>
        <item name="colorSurfaceVariant">@color/metro_light_panel</item>
        <item name="colorOnSurfaceVariant">@color/metro_light_text2</item>
        <item name="colorOnBackground">#000000</item>
        <item name="colorSurfaceContainerLowest">#FFFFFF</item>
        <item name="colorSurfaceContainerLow">@color/metro_light_bg</item>
        <item name="colorSurfaceContainer">@color/metro_light_panel</item>
        <item name="colorSurfaceContainerHigh">@color/metro_light_panel</item>
        <item name="colorSurfaceContainerHighest">@color/metro_light_panel_high</item>
        <item name="colorSurfaceBright">#FFFFFF</item>
        <item name="colorSurfaceDim">@color/metro_light_panel</item>
        <item name="colorOutline">#AAAAAA</item>
        <item name="colorOutlineVariant">@color/metro_light_line</item>
        <item name="android:colorBackground">@color/metro_light_bg</item>
        <item name="android:windowBackground">@color/metro_light_bg</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">@color/metro_light_text2</item>
        <item name="nav_drawer_background">@color/metro_light_bg</item>
        <item name="metroPanel">@color/metro_light_panel</item>
        <item name="metroSelectedRow">@color/metro_light_selected</item>
        <item name="playerBackground">@color/metro_light_bg</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ServeStream.MetroLight.Dialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.ServeStream.MetroLight.Dialog</item>
    </style>

    <style name="Widget.ServeStream.Metro.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorSurface</item>
        <item name="titleTextAppearance">@style/TextAppearance.ServeStream.Metro.Title</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="navigationIconTint">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.ServeStream.Metro.ActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">?attr/colorSurface</item>
        <item name="elevation">0dp</item>
        <item name="titleTextStyle">@style/TextAppearance.ServeStream.Metro.Title</item>
    </style>

    <style name="Widget.ServeStream.Metro.Button" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/metro_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="cornerRadius">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.ServeStream.Metro.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="backgroundTint">@color/metro_accent</item>
        <item name="tint">@android:color/white</item>
        <item name="elevation">0dp</item>
        <item name="pressedTranslationZ">0dp</item>
        <item name="hoveredFocusedTranslationZ">0dp</item>
    </style>

    <style name="Widget.ServeStream.Metro.NavigationView" parent="Widget.Material3.NavigationView">
        <item name="android:background">?attr/colorSurface</item>
        <item name="drawerLayoutCornerSize">0dp</item>
        <item name="itemShapeAppearanceOverlay">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="itemShapeFillColor">@color/metro_nav_fill</item>
        <item name="itemTextColor">@color/metro_nav_text</item>
        <item name="itemIconTint">@color/metro_nav_text</item>
    </style>

    <style name="ThemeOverlay.ServeStream.MetroDark.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/metro_dark_panel</item>
        <item name="colorSurfaceContainerHigh">@color/metro_dark_panel</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorOnSurfaceVariant">#FFFFFF</item>
        <item name="colorPrimary">@color/metro_accent</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.ServeStream.Metro.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.ServeStream.Metro.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.ServeStream.Metro.DialogButton</item>
    </style>

    <style name="ThemeOverlay.ServeStream.MetroLight.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorSurfaceContainerHigh">#FFFFFF</item>
        <item name="colorOnSurface">#000000</item>
        <item name="colorOnSurfaceVariant">#000000</item>
        <item name="colorPrimary">@color/metro_accent</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.ServeStream.Square</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.ServeStream.Metro.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.ServeStream.Metro.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.ServeStream.Metro.DialogButton</item>
    </style>

    <style name="Widget.ServeStream.Metro.DialogButton" parent="Widget.ServeStream.Metro.Button">
        <item name="android:minWidth">96dp</item>
        <item name="android:layout_marginStart">8dp</item>
    </style>
</resources>
